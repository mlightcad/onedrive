# Azure AD / Entra ID application (SPA) client ID
VITE_MSAL_CLIENT_ID=your_client_id_here
# common = work + personal; organizations = work only; consumers = personal only
# Or a specific tenant GUID
VITE_MSAL_TENANT_ID=common
# Must match an SPA redirect URI registered in Azure.
# Local dev is served at /onedrive/ so it matches GitHub Pages.
# Production: https://mlightcad.com/onedrive/
VITE_MSAL_REDIRECT_URI=http://localhost:5173/onedrive/
# Optional. Defaults to https://mlightcad.com/embed.html
# For local embed API (postMessage), run mlightcad.github.io on another port:
# VITE_MLIGHTCAD_EMBED_URL=http://localhost:5174/embed.html
# Optional. Origin of mlightcad.github.io site chrome (header/footer).
# Defaults to https://mlightcad.com — use the local homepage while testing:
# VITE_SITE_CHROME_ORIGIN=http://localhost:5174
